{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantau-karhutla-indonesia",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "secrets": {
    "required": [
      "FIRMS_MAP_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}
